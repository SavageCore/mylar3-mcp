# Base URL of your Mylar3 instance (no trailing /api)
MYLAR_URL=http://mylar.example.com:8090

# API key (32-char) - enable the API and generate a key in Mylar's web UI,
# or bootstrap with ?cmd=getAPI using HTTP basic credentials
MYLAR_API_KEY=

# Optional: HTTP_ROOT if Mylar3 is served under a subpath
# MYLAR_HTTP_ROOT=/
